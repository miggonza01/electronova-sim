# ============================================
# FILE: client/.env.v2
# PURPOSE: Variables para conectar con Backend v2
# ============================================

# API Configuration (Backend v2.4.0)
VITE_API_URL=https://electronova-backend-mvp.onrender.com/api
VITE_SOCKET_URL=https://electronova-backend-mvp.onrender.com

# Environment
NODE_ENV=production

# Application
VITE_APP_TITLE=ElectroNova - Simulador de Estrategias de Negocios v2.4.0
VITE_APP_DESCRIPTION=Sistema educativo de simulación de estrategias empresariales
VITE_APP_VERSION=v2.4.0

# Design System
VITE_THEME_COLOR=navy-900
VITE_THEME_COLOR_ACCENT=blue-600
VITE_BG_COLOR=slate-900

# Business Simulation
VITE_DEFAULT_COMPANY_NAME=Mi Empresa
VITE_INITIAL_CASH=500000
VITE_MAX_ROUNDS=8
VITE_GAME_DURATION_MINUTES=10
VITE_CAPACITY_LIMIT=6000

# Real-time Communication
VITE_RECONNECTION_ATTEMPTS=3
VITE_RECONNECTION_TIMEOUT=5000

# API Configuration
VITE_API_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3

# Monitoring
VITE_ERROR_REPORTING=true
VITE_DEBUG=false

# Título de la App (Para distinguir visualmente)
VITE_APP_TITLE=ElectroNova Simulator v2.0 (DEV)

# Flags de Funcionalidad
VITE_ENABLE_EVENTS=true
VITE_ENABLE_FINANCIALS=true