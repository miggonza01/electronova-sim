# ============================================
# FILE: client/.env.v2
# PURPOSE: Variables para conectar con Backend v2
# ============================================

# URL del Backend v2 (Puerto 5001)
VITE_API_URL=http://localhost:5001/api

# Título de la App (Para distinguir visualmente)
VITE_APP_TITLE=ElectroNova Simulator v2.0 (DEV)

# Flags de Funcionalidad
VITE_ENABLE_EVENTS=true
VITE_ENABLE_FINANCIALS=true