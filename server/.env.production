# ============================================
# FILE: server/.env.production
# VERSION: v2.4.0-production-ready
# PURPOSE: Production environment configuration for deployment
# RIGHTS: © Maribel Pinheiro & Miguel González | Dic-2025
# ============================================

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/electronova-production
MONGODB_URI_TEST=mongodb://localhost:27017/electronova-test

# JWT Configuration
JWT_SECRET=production-jwt-secret-change-this-in-real-deployment
JWT_SECRET_V2=production-jwt-secret-v2-change-this-in-real-deployment

# Server Configuration
PORT=5000
NODE_ENV=production

# Client Configuration
VITE_API_URL=https://electronova.yourdomain.com
VITE_API_URL_PROD=https://electronova.yourdomain.com

# Production Security
CORS_ORIGIN=https://electronova.yourdomain.com
SESSION_SECRET=production-session-secret-change-this

# Database Connection Options
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=5
DB_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Random Events Configuration
RANDOM_EVENTS_ENABLED=true
MAX_RANDOM_EVENTS_PER_ROUND=1
DEFAULT_RANDOM_EVENT_PROBABILITY=0.3

# Game Configuration
DEFAULT_CAPACITY_LIMIT=50000
MIN_CAPACITY_LIMIT=1000
MAX_COMPANIES_PER_GAME=10

# Performance Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090

# Email Configuration (Optional)
EMAIL_HOST=smtp.yourdomain.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASS=your-production-email-password

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads