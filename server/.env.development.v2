# ============================================
# FILE: server/.env.development.v2
# VERSION: v2.0.0-alpha.1
# PURPOSE: Variables de entorno aisladas para el desarrollo de la v2.0
# CHANGE LOG: Creación inicial apuntando a BD de desarrollo
# SPEC REF: Fase 0 - Preparación del Entorno
# ============================================

# --- CONFIGURACIÓN DE SERVIDOR ---
PORT=5001
# Usamos el puerto 5001 para evitar conflictos si ejecutas la v1.3 (usualmente 5000) al mismo tiempo.
NODE_ENV=development

# --- BASE DE DATOS (CRÍTICO: NO USAR LA DE PRODUCCIÓN) ---
# Reemplaza <USER>, <PASSWORD> y el host con tus datos reales de Atlas.
# Asegúrate de que termine en /electronova_v2_dev
 MONGODB_URI_V2=mongodb+srv://admin_mvp:qSg7QJLyAFQurXMY@clusterelectronova.tiehdyy.mongodb.net/electronova_mvp?appName=ClusterElectroNova&retryWrites=true&w=majority

# --- CONFIGURACIÓN DE JUEGO (Valores Iniciales v2.0) ---
# Definidos en el PDF Sección 4.1 GameSettingsSchema
INITIAL_COMPANY_CASH=500000.00
TOTAL_PRODUCTION_CAPACITY=6000
OBSOLESCENCE_PENALTY_RATE=10
MAX_ROUNDS=10

# --- SEGURIDAD ---
# Usa una cadena aleatoria larga para firmar tokens en desarrollo
JWT_SECRET_V2=SuperSecreto_ElectroNova_V2_2025