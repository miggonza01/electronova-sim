# MongoDB Atlas Configuration - CRITICAL
MONGODB_URI_V2=mongodb+srv://electronova_admin:<db_password>@electronova-v24-cluster.u9zknzi.mongodb.net/electronova_v2_4_0?retryWrites=true&w=majority&appName=electronova-v24-cluster
MONGODB_URI=mongodb+srv://electronova_admin:<db_password>@electronova-v24-cluster.u9zknzi.mongodb.net/electronova_v2_4_0?retryWrites=true&w=majority&appName=electronova-v24-cluster

# JWT Configuration - CRITICAL
JWT_SECRET_V2=electronova-production-jwt-secret-2026-secure-change-me
JWT_SECRET=electronova-production-jwt-secret-2026-secure-change-me

# Server Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Client Configuration
VITE_API_URL=https://electronova-sim-v24.vercel.app/api
VITE_SOCKET_URL=https://electronova-sim-v24.vercel.app
VITE_API_URL_PROD=https://electronova-sim-v24.vercel.app/api

# Production Security
CORS_ORIGIN=https://electronova-sim-v24.vercel.app
SESSION_SECRET=electronova-session-secret-2026-secure

# Database Connection Options
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=5
DB_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Random Events Configuration
RANDOM_EVENTS_ENABLED=true
MAX_RANDOM_EVENTS_PER_ROUND=1
DEFAULT_RANDOM_EVENT_PROBABILITY=0.3

# Game Configuration
DEFAULT_CAPACITY_LIMIT=50000
MIN_CAPACITY_LIMIT=1000
MAX_COMPANIES_PER_GAME=10

# Performance Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads