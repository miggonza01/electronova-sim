# FILE: Dockerfile.production
# VERSION: v2.4.0
# PURPOSE: Production Docker configuration for ElectroNova
# RIGHTS: © Maribel Pinheiro & Miguel González | Dic-2025
# ============================================

# Use Node.js 18 LTS as base
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# Copy package files
COPY server/package*.json ./

# Install production dependencies only
RUN npm ci --only=production && npm cache clean --force

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S electronova -u 1001

# Copy application code
COPY server/src ./src
COPY server/.env.production ./.env

# Create necessary directories
RUN mkdir -p logs uploads && \
    chown -R electronova:nodejs logs uploads

# Switch to non-root user
USER electronova

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:5000/api/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Expose port
EXPOSE 5000

# Start the application
CMD ["node", "src/app.js"]